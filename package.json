{
  "name": "re-student",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/smoke.mjs",
    "test:systems": "node --experimental-transform-types scripts/story.test.mjs",
    "test:chapter0": "node --experimental-transform-types scripts/chapter0.test.mjs",
    "test:chapter0:browser": "node scripts/chapter0-browser.mjs",
    "test": "npm run test:systems && npm run test:chapter0",
    "assets:bedroom": "node scripts/generate-bedroom.mjs"
  },
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "dependencies": { "phaser": "3.90.0" },
  "devDependencies": { "typescript": "5.9.3", "vite": "8.3.8", "@playwright/test": "1.65.1" }
}
